# Image for Julia development
# Based on the official image available at https://hub.docker.com/_/julia

FROM docker.io/library/julia:1.13@sha256:78a619b71166a46adbfe438a209275a096f7b534814646b1abe2541e4e0eeccc
LABEL wtf.metio.ci.root-allowed="development container run with the workspace mounted"

RUN julia --eval 'using Pkg; Pkg.add("LanguageServer")'
