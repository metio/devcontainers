# Image for Go development
# Based on the official image available at https://hub.docker.com/_/golang

FROM docker.io/library/golang:1.27@sha256:2920bb124f1a2e12a1d39f0cab756ae0068441ee1da7655dec7f5e374944095b
LABEL wtf.metio.ci.root-allowed="development container run with the workspace mounted"

RUN go install golang.org/x/tools/gopls@latest
