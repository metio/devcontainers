# Image for Java development with GraalVM
# Based on the official image available at https://github.com/graalvm/container

FROM ghcr.io/graalvm/graalvm-community:17@sha256:eac1619df619a6ac24333d3be635d10a217b1bb3aa04ca1485b0e29a011d460a
LABEL wtf.metio.ci.root-allowed="development container run with the workspace mounted"

# Install Java language server
ENV JDTLS_VERSION=1.35.0
ENV JDTLS_TIMESTAMP=202404251256
RUN curl --location --silent https://download.eclipse.org/jdtls/milestones/${JDTLS_VERSION}/jdt-language-server-${JDTLS_VERSION}-${JDTLS_TIMESTAMP}.tar.gz --output jdtls.tar.gz && \
    mkdir /jdtls && \
    tar --extract --gzip --file jdtls.tar.gz --directory /jdtls --no-same-owner && \
    rm jdtls.tar.gz

# Install Maven
ENV MAVEN_HOME /usr/share/maven

COPY --from=maven:3-eclipse-temurin-11@sha256:a2e6761472e54c817f185ab9c8e0f5e9f2aaff62cb1ed6a1b842f6faf08bd9e5 ${MAVEN_HOME} ${MAVEN_HOME}
COPY --from=maven:3-eclipse-temurin-11@sha256:a2e6761472e54c817f185ab9c8e0f5e9f2aaff62cb1ed6a1b842f6faf08bd9e5 /usr/local/bin/mvn-entrypoint.sh /usr/local/bin/mvn-entrypoint.sh
COPY --from=maven:3-eclipse-temurin-11@sha256:a2e6761472e54c817f185ab9c8e0f5e9f2aaff62cb1ed6a1b842f6faf08bd9e5 /usr/share/maven/ref/settings-docker.xml /usr/share/maven/ref/settings-docker.xml

RUN ln -s ${MAVEN_HOME}/bin/mvn /usr/bin/mvn

ENV MAVEN_CONFIG "/root/.m2"

ENTRYPOINT ["/usr/local/bin/mvn-entrypoint.sh"]
CMD ["mvn"]
